{
  "name": "agendrix-actions-for-github",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint **/*.ts",
    "build-all": "node build.js",
    "build-diff": "node build.js --diff \"$(git diff --name-only)\"",
    "git-add-dist": "git add \"**/dist/*.js\""
  },
  "pre-commit": [
    "build-diff",
    "git-add-dist"
  ],
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^3.4.0",
    "@typescript-eslint/parser": "^3.4.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^7.3.1",
    "js-yaml": "^3.14.0",
    "pre-commit": "^1.2.2",
    "prettier": "^2.0.5",
    "typescript": "^5.4.5"
  }
}
